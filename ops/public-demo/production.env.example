# Copy to /etc/agentledger-demo/production.env and set the hostname and TLS paths.
# Start on loopback. Change the binding only for the approved public launch.
DEMO_HOST=demo.example.com
DEMO_BIND_ADDRESS=127.0.0.1
DEMO_HTTPS_PORT=8443
DEMO_TLS_CERT=/etc/letsencrypt/live/demo.example.com/fullchain.pem
DEMO_TLS_KEY=/etc/letsencrypt/live/demo.example.com/privkey.pem
# Mode and credential policy are fixed in compose.public-demo.yaml.
