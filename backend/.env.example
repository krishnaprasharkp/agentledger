APP_MODE=local
# Choose a local URL-safe password before starting Docker Compose.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://agentledger:${POSTGRES_PASSWORD}@localhost:5433/agentledger
COMPOSE_DATABASE_URL=postgresql+psycopg://agentledger:${POSTGRES_PASSWORD}@db:5432/agentledger
EXTRACTION_PROVIDER=rules
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
